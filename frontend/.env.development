# Address of the Flask API during local development (python backend/app.py).
# The deployed site sets VITE_API_URL in Render to the web service's HTTPS address.
VITE_API_URL=http://localhost:5001

# Until graves are placed on the map (placements.json), lay them out in a
# labelled demo grid by section, row and stone. Development only: the deployed
# site leaves this unset and draws only placed graves.
VITE_MAP_DEMO_LAYOUT=true
