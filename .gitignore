# macOS
.DS_Store

# Secrets such as API keys live in .env files, which are never committed
.env

# Python
__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# Gravestone photos (several GB; kept out of git)
ocr_pipeline/data/

# Conda environment, created inside ocr_pipeline/ from environment.yml
ocr_pipeline/.conda/

# Working folder of extract_text_gemini.ipynb: photo uploads, batch jobs and
# the cache of Gemini answers
ocr_pipeline/extraction/

# Name-search experiments: only the notebooks, the environment, their input
# (the curated dictionary) and their outputs are tracked, except the large
# regenerable arrays of step 4. Everything else in search_algorithm/ stays
# local: the conda environment, downloaded models, the PostgreSQL cluster and
# the design documents.
search_algorithm/*
!search_algorithm/step_*.ipynb
!search_algorithm/environment.yml
!search_algorithm/inputs/
!search_algorithm/outputs/
search_algorithm/outputs/*.npz
