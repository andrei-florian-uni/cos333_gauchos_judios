# macOS
.DS_Store

# Secrets such as API keys live in .env files, which are never committed
.env

# Python
__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# Gravestone photos (several GB; kept out of git)
ocr_pipeline/data/

# Conda environment, created inside ocr_pipeline/ from environment.yml
ocr_pipeline/.conda/

# Working folder of extract_text_gemini.ipynb: photo uploads, batch jobs and
# the cache of Gemini answers
ocr_pipeline/extraction/

# Name-search experiments: only the notebooks, the environment, the curated
# dictionary, the evaluation set and the results are tracked. Everything else
# in search_algorithm/ stays local: the conda environment, downloaded models,
# regenerable caches, the design documents and the human-review files.
search_algorithm/*
!search_algorithm/step_*.ipynb
!search_algorithm/environment.yml
!search_algorithm/dictionaries/
search_algorithm/dictionaries/*
!search_algorithm/dictionaries/d1_curated.csv
!search_algorithm/eval/
!search_algorithm/results/
